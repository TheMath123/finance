{
  "name": "finance-guide",
  "version": "1.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev worker --filter='./apps/*'",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome check ./",
    "lint:fix": "biome check --write ./",
    "prepare": "husky || true",
    "db:generate": "bun --cwd=packages/db run generate",
    "db:migrate": "bun --cwd=packages/db run migrate",
    "db:seed": "bun --cwd=packages/db run seed",
    "db:studio": "bun --cwd=packages/db run studio",
    "worker": "bun --cwd=apps/backend run worker",
    "tunnel:open": "bun scripts/tunnel/open.ts",
    "tunnel:status": "bun scripts/tunnel/status.ts",
    "tunnel:close": "bun scripts/tunnel/close.ts",
    "release:dashboard": "bun scripts/release.ts dashboard",
    "release:api": "bun scripts/release.ts api",
    "auth:login": "bun scripts/api-login.ts",
    "docs:api": "bun docs/api/merge-fragments.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "husky": "9.1.7",
    "turbo": "2.10.5",
    "typescript": "5.9.3"
  }
}
