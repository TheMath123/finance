# Storage de arquivos (Cloudflare R2, S3-compatible) — consumido por quem chama createS3Storage
# STORAGE_BUCKET é opcional — default "finance-storage"/"finance-storage-dev" (conforme NODE_ENV)
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
