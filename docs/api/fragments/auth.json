{
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Registrar novo usuário",
        "description": "Cria usuário, workspace pessoal (com categorias padrão, banco 'carteira' e conta principal) e retorna sessão autenticada (tokens). Dispara e-mail de verificação. Pública, limitada a 5 tentativas/hora por IP. 409 se `email_taken`.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthRegisterBody" },
              "example": {
                "name": "Ana Souza",
                "email": "usuario@exemplo.com",
                "password": "SenhaForte123",
                "termsAccepted": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado, sessão emitida.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSession" }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 409 `email_taken`, 429 `rate_limited`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Login",
        "description": "Autentica com e-mail e senha e retorna sessão (tokens). Pública, limitada a 10 tentativas/min por IP. 401 se `invalid_credentials` (inclui conta bloqueada por tentativas ou sem workspace padrão), 403 se `account_suspended`.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthLoginBody" },
              "example": {
                "email": "usuario@exemplo.com",
                "password": "SenhaForte123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login bem-sucedido, sessão emitida.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSession" }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `invalid_credentials`, 403 `account_suspended`, 429 `rate_limited`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Renovar sessão",
        "description": "Troca um refresh token válido por uma nova sessão (rotação: o token usado é sempre invalidado, mesmo se expirado). Pública, limitada a 30 tentativas/min por IP. 401 se `invalid_token`.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthRefreshBody" },
              "example": {
                "refreshToken": "rt_9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão renovada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSession" }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `invalid_token`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Logout",
        "description": "Revoga o refresh token informado (best-effort: não falha se o token já não existir). Pública — o próprio refresh token é a credencial da operação.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthLogoutBody" },
              "example": {
                "refreshToken": "rt_9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sessão encerrada (sem corpo)."
          },
          "4XX": {
            "description": "Erro de validação (400 `validation_error`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Solicitar recuperação de senha",
        "description": "Envia código de 6 dígitos por e-mail se a conta existir e tiver e-mail verificado. Resposta sempre genérica e sempre 200 — não revela se o e-mail existe (OWASP). Pública, limitada a 5 tentativas/hora por IP, mais cooldown de 10 min por e-mail alvo.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthForgotPasswordBody"
              },
              "example": { "email": "usuario@exemplo.com" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mensagem genérica de confirmação (sempre a mesma, exista ou não o e-mail).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthMessageResponse" },
                "example": {
                  "message": "Se o e-mail existir, enviaremos as instruções de recuperação."
                }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação (400 `validation_error`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/verify-reset-code": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Verificar código de redefinição de senha",
        "description": "Confirma se o código de 6 dígitos enviado por e-mail é válido, sem consumi-lo (a validação de verdade e o consumo acontecem em /auth/reset-password). Pública, limitada a 5 tentativas/15min por e-mail alvo. 401 se `invalid_code`.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthVerifyResetCodeBody"
              },
              "example": { "email": "usuario@exemplo.com", "code": "482913" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Código válido.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthMessageResponse" },
                "example": { "message": "Código válido." }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `invalid_code`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Redefinir senha",
        "description": "Consome o código de 6 dígitos e define a nova senha. Revoga todas as sessões ativas (todos os refresh tokens) e notifica por e-mail. Pública, limitada a 5 tentativas/15min por e-mail alvo. 401 se `invalid_code`.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthResetPasswordBody" },
              "example": {
                "email": "usuario@exemplo.com",
                "code": "482913",
                "password": "NovaSenhaForte456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha redefinida.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthMessageResponse" },
                "example": {
                  "message": "Senha redefinida. Faça login com a nova senha."
                }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `invalid_code`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Verificar e-mail",
        "description": "Consome o token enviado por e-mail no registro e marca o e-mail como verificado. Pública, limitada a 10 tentativas/min por IP. 401 se `invalid_token`.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthVerifyEmailBody" },
              "example": {
                "token": "vt_1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "E-mail verificado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthMessageResponse" },
                "example": { "message": "E-mail verificado." }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `invalid_token`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Autenticação"],
        "summary": "Obter perfil do usuário logado",
        "description": "Retorna os dados do usuário autenticado e o workspace padrão. Requer autenticação (usuário logado). 401 se `invalid_token` (usuário sem workspace padrão associado).",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Perfil do usuário.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthMeResponse" }
              }
            }
          },
          "4XX": {
            "description": "Erro de autenticação (401 `unauthorized`/`invalid_token`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Autenticação"],
        "summary": "Atualizar nome do perfil",
        "description": "Atualiza o nome do usuário logado, sem confirmação extra. Requer autenticação (usuário logado), limitada a 10 requisições/hora por usuário. 401 se `invalid_token`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthUpdateNameBody" },
              "example": { "name": "Ana Souza Lima" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nome atualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUpdateNameResponse"
                },
                "example": { "name": "Ana Souza Lima" }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou autenticação (400 `validation_error`, 401 `unauthorized`/`invalid_token`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/me/delete/request": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Solicitar exclusão de conta (passo 1/2)",
        "description": "Reautentica com a senha atual e envia um código de 6 dígitos para o e-mail já cadastrado do usuário, iniciando a exclusão de conta (LGPD). A exclusão de fato só ocorre em /auth/me/delete/confirm. Requer autenticação, limitada a 5 tentativas/hora por usuário. 401 se `invalid_credentials`, 429 se `rate_limited`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequestAccountDeletionBody"
              },
              "example": { "password": "SenhaForte123" }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Código de confirmação enviado (sem corpo)."
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `unauthorized`/`invalid_credentials`, 429 `rate_limited`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/me/delete/confirm": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Confirmar exclusão de conta (passo 2/2)",
        "description": "Consome o código de 6 dígitos e exclui a conta do usuário definitivamente (LGPD). Workspaces em que o usuário é o único owner também são excluídos. Requer autenticação, limitada a 5 tentativas/15min por usuário. 401 se `invalid_code`, 429 se `rate_limited`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthConfirmAccountDeletionBody"
              },
              "example": { "code": "482913" }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Conta excluída (sem corpo)."
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `unauthorized`/`invalid_code`, 429 `rate_limited`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/me/email/request-change": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Solicitar troca de e-mail (passo 1/2)",
        "description": "Reautentica com a senha atual e envia um código de 6 dígitos para o e-mail NOVO, provando posse antes de qualquer troca. A troca de fato só ocorre em /auth/me/email/confirm-change. Requer autenticação, limitada a 5 tentativas/hora por usuário. 401 se `invalid_credentials`, 409 se `email_already_in_use`, 429 se `rate_limited`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequestEmailChangeBody"
              },
              "example": {
                "newEmail": "novo.email@exemplo.com",
                "currentPassword": "SenhaForte123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Código de confirmação enviado ao e-mail novo. Corpo JSON `null` (use case retorna `right(null)`, sem envelope de dados).",
            "content": {
              "application/json": {
                "schema": { "type": "null", "nullable": true }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `unauthorized`/`invalid_credentials`, 409 `email_already_in_use`, 429 `rate_limited`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/me/email/confirm-change": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Confirmar troca de e-mail (passo 2/2)",
        "description": "Consome o código enviado ao e-mail novo, aplica a troca e notifica o e-mail antigo por segurança. Requer autenticação, limitada a 5 tentativas/15min por usuário. 401 se `invalid_token`/`invalid_code`, 409 se `no_pending_email_change`/`email_already_in_use`, 429 se `rate_limited`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthConfirmEmailChangeBody"
              },
              "example": { "code": "482913" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "E-mail alterado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfirmEmailChangeResponse"
                },
                "example": { "email": "novo.email@exemplo.com" }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `unauthorized`/`invalid_token`/`invalid_code`, 409 `no_pending_email_change`/`email_already_in_use`, 429 `rate_limited`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/me/password": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Alterar senha do perfil",
        "description": "Reautentica com a senha atual e define a nova senha. Revoga todas as sessões, exceto a atual se `currentRefreshToken` for enviado. Requer autenticação. 401 se `invalid_credentials`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthChangePasswordBody"
              },
              "example": {
                "currentPassword": "SenhaForte123",
                "newPassword": "NovaSenhaForte456",
                "currentRefreshToken": "rt_9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha alterada. Corpo JSON `null` (use case retorna `right(null)`, sem envelope de dados).",
            "content": {
              "application/json": {
                "schema": { "type": "null", "nullable": true }
              }
            }
          },
          "4XX": {
            "description": "Erro de validação ou negócio (400 `validation_error`, 401 `unauthorized`/`invalid_credentials`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "example": "validation_error" },
              "message": {
                "type": "string",
                "example": "Payload inválido."
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "AuthMessageResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "emailVerifiedAt",
          "pendingEmail",
          "platformRole"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "name": { "type": "string", "example": "Ana Souza" },
          "email": {
            "type": "string",
            "format": "email",
            "example": "usuario@exemplo.com"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "emailVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2026-08-10T14:32:00.000Z"
          },
          "pendingEmail": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "platformRole": {
            "type": "string",
            "enum": ["user", "superadmin"],
            "example": "user"
          }
        }
      },
      "AuthSession": {
        "type": "object",
        "required": [
          "user",
          "defaultWorkspaceId",
          "accessToken",
          "refreshToken"
        ],
        "properties": {
          "user": { "$ref": "#/components/schemas/AuthUser" },
          "defaultWorkspaceId": {
            "type": "string",
            "format": "uuid",
            "example": "9c858901-8a57-4791-81fe-4c455b099bc9"
          },
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.fake-payload.fake-signature"
          },
          "refreshToken": {
            "type": "string",
            "example": "rt_9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c"
          }
        }
      },
      "AuthMeResponse": {
        "type": "object",
        "required": ["user", "defaultWorkspaceId"],
        "properties": {
          "user": { "$ref": "#/components/schemas/AuthUser" },
          "defaultWorkspaceId": {
            "type": "string",
            "format": "uuid",
            "example": "9c858901-8a57-4791-81fe-4c455b099bc9"
          }
        }
      },
      "AuthUpdateNameResponse": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "example": "Ana Souza Lima" }
        }
      },
      "AuthConfirmEmailChangeResponse": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "novo.email@exemplo.com"
          }
        }
      },
      "AuthRegisterBody": {
        "type": "object",
        "required": ["name", "email", "password", "termsAccepted"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "usuario@exemplo.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "example": "SenhaForte123"
          },
          "termsAccepted": {
            "type": "boolean",
            "enum": [true],
            "description": "Precisa ser exatamente `true` — aceite dos termos é obrigatório.",
            "example": true
          }
        }
      },
      "AuthLoginBody": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "usuario@exemplo.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "SenhaForte123"
          }
        }
      },
      "AuthRefreshBody": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "example": "rt_9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c"
          }
        }
      },
      "AuthLogoutBody": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "example": "rt_9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c"
          }
        }
      },
      "AuthForgotPasswordBody": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "usuario@exemplo.com"
          }
        }
      },
      "AuthVerifyResetCodeBody": {
        "type": "object",
        "required": ["email", "code"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "usuario@exemplo.com"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "minLength": 6,
            "maxLength": 6,
            "description": "Código numérico de 6 dígitos.",
            "example": "482913"
          }
        }
      },
      "AuthResetPasswordBody": {
        "type": "object",
        "required": ["email", "code", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "usuario@exemplo.com"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "minLength": 6,
            "maxLength": 6,
            "example": "482913"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "example": "NovaSenhaForte456"
          }
        }
      },
      "AuthVerifyEmailBody": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "example": "vt_1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d"
          }
        }
      },
      "AuthRequestAccountDeletionBody": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "SenhaForte123"
          }
        }
      },
      "AuthConfirmAccountDeletionBody": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "minLength": 6,
            "maxLength": 6,
            "example": "482913"
          }
        }
      },
      "AuthUpdateNameBody": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Ana Souza Lima"
          }
        }
      },
      "AuthRequestEmailChangeBody": {
        "type": "object",
        "required": ["newEmail", "currentPassword"],
        "properties": {
          "newEmail": {
            "type": "string",
            "format": "email",
            "example": "novo.email@exemplo.com"
          },
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "example": "SenhaForte123"
          }
        }
      },
      "AuthConfirmEmailChangeBody": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "minLength": 6,
            "maxLength": 6,
            "example": "482913"
          }
        }
      },
      "AuthChangePasswordBody": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "example": "SenhaForte123"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "example": "NovaSenhaForte456"
          },
          "currentRefreshToken": {
            "type": "string",
            "minLength": 1,
            "description": "Se enviado, só esta sessão sobrevive à revogação das demais.",
            "example": "rt_9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c"
          }
        }
      }
    }
  }
}
