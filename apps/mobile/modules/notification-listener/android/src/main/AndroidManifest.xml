<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Permissão "normal" (concedida automaticamente, sem diálogo) — só habilita
    o app a MOSTRAR o convite do sistema pra sair da lista de otimização de
    bateria (Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS); quem
    decide aceitar ou não continua sendo o usuário, na tela do próprio
    Android. Sem isso o processo do app (e o NotificationListenerService
    junto, já que vivem no mesmo processo) é o alvo nº1 de otimizações
    agressivas de bateria com o app fechado.
  -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <application>
    <!--
      Declarado aqui (manifest da lib) em vez de via config plugin: o Android
      Gradle Plugin já faz o merge automático deste manifest no da app
      durante o build — não precisa de withAndroidManifest nem risco da
      entrada sumir em rebuilds sucessivos (issue conhecida do expo/expo#19548
      com service/receiver via config plugin).

      android:permission é o que protege o serviço (só o sistema pode
      bindar) — não é uma permissão pedida pelo app.
    -->
    <service
      android:name=".AppNotificationListenerService"
      android:exported="true"
      android:label="Marcelus"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
