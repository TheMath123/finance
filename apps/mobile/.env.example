# Vars EXPO_PUBLIC_* ficam expostas no bundle — nunca colocar segredo aqui
EXPO_PUBLIC_API_URL=http://localhost:3000
# Número do bot no WhatsApp (E.164, sem "+") — opcional, só usado pra abrir o wa.me com o código pré-preenchido
EXPO_PUBLIC_WHATSAPP_NUMBER=
# Project ID do Microsoft Clarity (heatmap + gravação de sessão) — não é
# segredo, só identifica o projeto no painel. Opcional: sem valor, o SDK
# simplesmente não inicializa (ver src/app/_layout.tsx). Mesmo painel do
# projeto web (dashboard), mas Clarity trata mobile e web como fontes
# separadas dentro do mesmo project ID.
EXPO_PUBLIC_CLARITY_PROJECT_ID=

# Login com Google (GoogleSignin) — Client IDs do Google Cloud Console
# (Credentials → OAuth client ID). Não são segredo (client ID é público por
# natureza), mas exigem setup manual: criar um client "Web application"
# (mesmo valor de PUBLIC_GOOGLE_CLIENT_ID no dashboard — é o único que entra
# em GOOGLE_CLIENT_IDS no backend: o `idToken` sempre tem esse client Web
# como audience, nunca o Android/iOS, não importa a plataforma de origem) e,
# pra build nativo, um client "iOS" (bundle id app.marcelus.mobile) e um
# client "Android" (package app.marcelus.mobile + SHA-1 do keystore — rodar
# `cd android && ./gradlew signingReport` depois do `expo prebuild` pra
# pegar o SHA-1 de debug). O client Android só precisa EXISTIR cadastrado
# certinho no Console (pacote + SHA-1) — o Play Services usa ele sozinho pra
# confirmar a identidade do app; não entra em nenhuma env nem código aqui
# (GoogleSignin.configure só aceita webClientId/iosClientId).
# Opcional: sem EXPO_PUBLIC_CLIENT_ID, o botão "Continuar com Google" some
# (ver lib/hooks/use-google-auth.ts).
EXPO_PUBLIC_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Não é EXPO_PUBLIC_* de propósito: só entra em app.config.ts (build-time,
# nunca no bundle JS) — é o "iOS URL scheme" (client ID iOS invertido, ex.
# com.googleusercontent.apps.123-abc) que o plugin do GoogleSignin precisa
# pra registrar o redirect no Info.plist durante o `expo prebuild`.
GOOGLE_IOS_URL_SCHEME=
