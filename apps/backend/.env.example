# Banco (mesmo valor de packages/db/.env.example — o processo do backend é quem efetivamente conecta)
DATABASE_URL=postgres://finance:finance@localhost:5432/finance

# Redis (docker compose local) — fila (BullMQ) e rate limiter (M2)
REDIS_URL=redis://localhost:6379

# Backend
PORT=3000
# fatal|error|warn|info|debug|trace — em dev os logs saem coloridos via pino-pretty
LOG_LEVEL=info
# true apenas atrás de proxy confiável (Railway/Fly) — habilita X-Forwarded-For no rate limit
TRUST_PROXY=false
# Versão vigente dos termos de uso (registrada no aceite do cadastro)
TERMS_VERSION=2026-07-13

# Auth (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-forte-com-32-caracteres-ou-mais

# E-mail (Resend via SMTP) — mesmo valor de packages/email/.env.example
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Finance <no-reply@example.com>"

# WhatsApp (Meta Cloud API — M2-06). Phone Number ID e Access Token vêm do
# painel do Meta for Developers (WhatsApp > Configuração da API). O
# VERIFY_TOKEN é uma string que você mesmo inventa e cadastra igual nos dois
# lados (aqui e no campo "Verify token" do webhook, no painel). O APP_SECRET
# vem de Configurações do app > Básico.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# IA (M2-07) — gateway multi-provedor OpenRouter (openrouter.ai/keys), uma
# chave só pra qualquer modelo/empresa (evita lock-in). Modelos trocáveis
# sem mudar código; defaults abaixo são baratos/eficientes (Gemini Flash).
# Outras opções: moonshotai/kimi-k2.5, deepseek/deepseek-chat, ou qualquer
# modelo gratuito (sufixo ":free") do catálogo em openrouter.ai/models.
OPENROUTER_API_KEY=
AI_ROUTER_MODEL=google/gemini-2.5-flash-lite
AI_ANALYST_MODEL=google/gemini-2.5-flash

# Storage de arquivos (M3-01, @finance/storage) — Cloudflare R2 (S3-compatible).
# Nomes de env genéricos (STORAGE_*, nunca AWS_*/R2_*) pra não prender o código
# a um provedor. DIFERENTE do resto das integrações deste .env.example: essas
# aqui são validadas no BOOT (main/env.ts), não no primeiro uso — o backend não
# sobe sem elas preenchidas (decisão de 2026-07-19, alinhando com o padrão do
# eco-system-sales).
# Opcional — default "finance-storage" em produção (NODE_ENV=production) ou
# "finance-storage-dev" fora dela. Só preenche se precisar de um bucket
# diferente do padrão do projeto.
STORAGE_BUCKET=
# Opcional — R2 ignora o valor, default "auto". Só importa numa AWS S3 real.
STORAGE_REGION=
# Endpoint da conta no R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
# Access Key ID / Secret do R2 API Token (painel R2 > Manage R2 API Tokens),
# não são as chaves da conta Cloudflare geral.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Dashboard web (M4) — origem permitida no CORS. O fluxo normal do dashboard é
# server-to-server (o servidor do SvelteKit chama a API), então isto é defesa
# em profundidade; em dev o Vite serve em http://localhost:5173.
# Também usada pra montar o link de confirmação de e-mail (/verify-email?token=...).
DASHBOARD_ORIGIN=http://localhost:5173

# Login social com Google — Client IDs aceitos como audience, separados por
# vírgula (Google Cloud Console > APIs & Services > Credentials). Hoje só o
# client "Web" (dashboard); a Fase 2 (mobile) soma os clients iOS/Android
# aqui mesmo. Vazio = login com Google fica indisponível, sem quebrar o boot.
GOOGLE_CLIENT_IDS=

# Stripe (M5-05) — checkout hospedado + Customer Portal. Chaves de teste vêm
# do Dashboard do Stripe (Developers > API keys), modo teste (sk_test_...).
# Pra rodar o webhook localmente: `stripe listen --forward-to
# localhost:3000/webhooks/stripe` — o próprio comando imprime o
# STRIPE_WEBHOOK_SECRET (whsec_...) a usar aqui. Validadas no primeiro uso
# (mesmo padrão de WhatsApp/IA), não travam o boot do backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
