# Banco (mesmo valor de packages/db/.env.example — o processo do backend é quem efetivamente conecta)
DATABASE_URL=postgres://finance:finance@localhost:5432/finance

# Redis (docker compose local) — fila (BullMQ) e rate limiter (M2)
REDIS_URL=redis://localhost:6379

# Backend
PORT=3000
# fatal|error|warn|info|debug|trace — em dev os logs saem coloridos via pino-pretty
LOG_LEVEL=info
# true apenas atrás de proxy confiável (Railway/Fly) — habilita X-Forwarded-For no rate limit
TRUST_PROXY=false
# Versão vigente dos termos de uso (registrada no aceite do cadastro)
TERMS_VERSION=2026-07-13

# Auth (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-forte-com-32-caracteres-ou-mais

# E-mail (Resend via SMTP) — mesmo valor de packages/email/.env.example
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Finance <no-reply@example.com>"

# WhatsApp (Meta Cloud API — M2-06). Phone Number ID e Access Token vêm do
# painel do Meta for Developers (WhatsApp > Configuração da API). O
# VERIFY_TOKEN é uma string que você mesmo inventa e cadastra igual nos dois
# lados (aqui e no campo "Verify token" do webhook, no painel). O APP_SECRET
# vem de Configurações do app > Básico.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# IA (M2-07) — gateway multi-provedor OpenRouter (openrouter.ai/keys), uma
# chave só pra qualquer modelo/empresa (evita lock-in). Modelos trocáveis
# sem mudar código; defaults abaixo são baratos/eficientes (Gemini Flash).
# Outras opções: moonshotai/kimi-k2.5, deepseek/deepseek-chat, ou qualquer
# modelo gratuito (sufixo ":free") do catálogo em openrouter.ai/models.
OPENROUTER_API_KEY=
AI_ROUTER_MODEL=google/gemini-2.5-flash-lite
AI_ANALYST_MODEL=google/gemini-2.5-flash

# Storage de arquivos (M3-01) — AWS S3 hoje; nomes genéricos de propósito
# pra trocar pra Cloudflare R2 (ou outro S3-compatible) mais pra frente
# sem mudar código, só valor de env. STORAGE_ENDPOINT/STORAGE_FORCE_PATH_STYLE
# ficam vazios/false pra AWS S3 real — só preenche na troca pra R2.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
