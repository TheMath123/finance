# Env de ferramentas de desenvolvimento na raiz do monorepo (scripts/) — não é a
# env do backend em si (essa continua em apps/backend/.env). Usada só pelo
# scripts/api-login.ts pra logar contra a API local/remota e gravar um
# accessToken pronto pra usar em testes manuais e no ambiente do Apidog.
#
# NUNCA preencha com credenciais reais de produção — use sempre um usuário de
# teste/seed (ex.: o usuário demo criado por `bun run db:seed`).

# URL base da API — aponta pro backend local por padrão.
API_URL=http://localhost:3000

# Credenciais do usuário de teste usado pelo script de login.
API_LOGIN_EMAIL=
API_LOGIN_PASSWORD=

# Preenchido automaticamente por `bun run auth:login` — não editar à mão.
API_ACCESS_TOKEN=
